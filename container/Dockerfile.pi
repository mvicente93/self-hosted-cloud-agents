FROM debian:bookworm-slim

ARG PORT=3000

# run as non-root
RUN groupadd -r cloud-container && useradd -r -g cloud-container -m -d /home/cloud-container cloud-container

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl bash git ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

USER cloud-container

WORKDIR /home/cloud-container

COPY pi-server/package.json ./pi-agent/
COPY pi-server/index.ts ./pi-agent/

WORKDIR /home/cloud-container/pi-agent

RUN bun install

ENV PORT=$PORT

EXPOSE $PORT

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:$PORT/ || exit 1

CMD ["bun", "run", "index.ts"]